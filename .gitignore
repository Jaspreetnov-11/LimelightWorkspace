# This repo is the Limelight Workspace: only these four app folders are in it.
# Everything else in E:\Limelight Ai (other projects, media, packages) stays out.
/*
!/.gitignore
!/README.md
!/limelight-workspace/
!/limelight-office/
!/limelight-studio/
!/limelight-ai/
# the AI engine's own scripts (tools\llama); its program files (llama-server.exe, dlls) stay out
!/tools/
/tools/*
!/tools/llama/
/tools/llama/*
!/tools/llama/setup-models.py
!/tools/llama/start-engine.ps1
!/tools/llama/Limelight AI Engine (no window).vbs
